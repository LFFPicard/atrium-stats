# Full URL Atrium Stats is served from (include protocol, no trailing slash)
APP_URL=https://stats.yourdomain.com

# Path to the SQLite database file — must be inside the mounted data volume
DATABASE_URL=/app/data/atrium-stats.db

# Sentinel connection — a read-tier key is sufficient, Atrium Stats never needs admin access.
# Generate one from Sentinel's admin UI: /admin/api-keys
SENTINEL_URL=http://sentinel-host:7700
SENTINEL_API_KEY=sk_read_xxxxx

# Plex OAuth — used only to identify who's signing in, never stored beyond the initial handshake.
# Any string works, but keep it stable so Plex recognises repeat sign-ins from this app.
PLEX_CLIENT_IDENTIFIER=atrium-stats-changeme
